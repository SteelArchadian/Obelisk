{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obelisk",
  "version": "0.2.14",
  "identifier": "dev.obelisk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Obelisk",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 600,
        "backgroundColor": "#16171a",
        "visible": false,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; media-src 'self' asset: http://asset.localhost https:; font-src 'self' data:; frame-src https://www.youtube-nocookie.com; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Obelisk",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp"
      }
    },
    "shortDescription": "A friendly front end for Prism Launcher",
    "publisher": "SteelArchadian",
    "resources": {
      "libs/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "createUpdaterArtifacts": true,
    "copyright": "LGPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENjg1NTQwRUQyMjRGNDcKUldSSFR5THRRRlZvSGZuSEl0NSs2WndBVGNHeDZkMUIxVUl3MjhSQUdwb1pOUHdmOGlpak1UY1oK",
      "endpoints": [
        "https://github.com/SteelArchadian/Obelisk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
